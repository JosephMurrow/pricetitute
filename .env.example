# Скопируй в .env и при необходимости поправь.
# Значения ниже совпадают с docker-compose.yml и годятся для локальной разработки.

DATABASE_URL="postgresql://pricetitute:pricetitute@localhost:5432/pricetitute?schema=public"

HOST=localhost
PORT=3000

# Секрет для подписи сессионных cookie. Минимум 32 символа.
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET="замени-меня-на-случайную-строку-минимум-32-символа"
