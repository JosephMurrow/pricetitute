# Боевое окружение. Скопировать в .env рядом с docker-compose.prod.yml.
# С реальными значениями в git не коммитить.

POSTGRES_USER=platitutka
POSTGRES_DB=platitutka
# openssl rand -base64 24
POSTGRES_PASSWORD=

# Секрет подписи сессий, от 32 символов: openssl rand -base64 48
# Менять нельзя без нужды — смена разлогинивает всех разом.
SESSION_SECRET=

# Имя, на которое Caddy выпустит сертификат.
DOMAIN=pricetitute.duckdns.org
# Токен DuckDNS: он один на весь аккаунт, тот же, что у соседних доменов.
DUCKDNS_TOKEN=
